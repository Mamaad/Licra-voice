{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mamaad/Licra-voice/protocol/v1",
  "protocol_version": 1,
  "$ref": "#/$defs/Envelope",
  "$defs": {
    "Effect": {
      "enum": [
        "ALLOW",
        "DENY",
        "INHERIT"
      ]
    },
    "FeatureCapability": {
      "enum": [
        "voice",
        "screen_share",
        "youtube_sync",
        "server_files",
        "remote_browser",
        "chat"
      ]
    },
    "Channel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sort_order": {
          "type": "integer"
        },
        "max_users": {
          "type": "integer"
        },
        "audio_profile": {
          "enum": [
            "eco",
            "standard",
            "high"
          ]
        },
        "has_password": {
          "type": "boolean"
        },
        "is_permanent": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent_id",
        "name",
        "description",
        "sort_order",
        "max_users",
        "audio_profile",
        "has_password",
        "is_permanent",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "muted": {
          "type": "boolean"
        },
        "deafened": {
          "type": "boolean"
        },
        "server_muted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "nickname",
        "channel_id",
        "muted",
        "deafened",
        "server_muted"
      ],
      "additionalProperties": false
    },
    "Role": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "protected": {
          "type": "boolean"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Effect"
          }
        }
      },
      "required": [
        "id",
        "name",
        "protected",
        "permissions"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "bootstrap_available": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "self_id": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Channel"
          }
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/User"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Role"
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "channel_permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "chat": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "history_enabled": {
              "type": "boolean"
            },
            "max_message_length": {
              "type": "integer"
            },
            "messages_per_second": {
              "type": "integer"
            },
            "messages_per_minute": {
              "type": "integer"
            },
            "edits_per_minute": {
              "type": "integer"
            },
            "typing_per_second": {
              "type": "integer"
            },
            "channel_history_limit": {
              "type": "integer"
            },
            "private_history_limit": {
              "type": "integer"
            },
            "retention_days": {
              "type": "integer"
            },
            "max_stored_messages": {
              "type": "integer"
            },
            "max_threads": {
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "history_enabled",
            "max_message_length",
            "messages_per_second",
            "messages_per_minute",
            "edits_per_minute",
            "typing_per_second",
            "channel_history_limit",
            "private_history_limit",
            "retention_days"
          ]
        },
        "screen": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_shares_per_channel": {
              "type": "integer"
            },
            "max_bitrate": {
              "type": "integer"
            },
            "max_height": {
              "type": "integer"
            },
            "max_fps": {
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "max_shares_per_channel",
            "max_bitrate",
            "max_height",
            "max_fps"
          ]
        }
      },
      "required": [
        "server",
        "self_id",
        "channels",
        "users",
        "roles",
        "permissions",
        "channel_permissions"
      ],
      "additionalProperties": false
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "payload": {}
      },
      "required": [
        "type",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    },
    "ChatMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "channel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "author_fingerprint": {
          "type": "string"
        },
        "author_nickname_snapshot": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "edited_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply_to_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "nickname": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "deleted": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "nickname",
            "content",
            "deleted"
          ]
        }
      },
      "required": [
        "id",
        "thread_id",
        "channel_id",
        "author_fingerprint",
        "author_nickname_snapshot",
        "content",
        "created_at",
        "edited_at",
        "deleted_at",
        "reply_to_message_id"
      ],
      "additionalProperties": false
    }
  },
  "events": [
    "CLIENT_HELLO",
    "SERVER_HELLO",
    "AUTHENTICATE",
    "SNAPSHOT",
    "ACK",
    "USER_CONNECTED",
    "USER_DISCONNECTED",
    "USER_UPDATED",
    "USER_MOVED",
    "CHANNEL_CREATED",
    "CHANNEL_UPDATED",
    "CHANNEL_DELETED",
    "ROLE_UPDATED",
    "PERMISSIONS_UPDATED",
    "VOICE_STATE_UPDATED",
    "VOICE_JOIN",
    "VOICE_LEFT",
    "VOICE_REJOIN_REQUIRED",
    "SERVER_INFO_UPDATED",
    "KICK",
    "BAN",
    "ERROR",
    "PING",
    "PONG",
    "CHAT_OPEN",
    "CHAT_HISTORY",
    "CHAT_SEND",
    "CHAT_EDIT",
    "CHAT_DELETE",
    "CHAT_READ",
    "CHAT_LIST",
    "CHAT_TYPING",
    "CHAT_MESSAGE_CREATED",
    "CHAT_MESSAGE_EDITED",
    "CHAT_MESSAGE_DELETED",
    "PRIVATE_MESSAGE_CREATED",
    "PRIVATE_MESSAGE_EDITED",
    "PRIVATE_MESSAGE_DELETED",
    "CHAT_UNREAD",
    "TYPING_STARTED",
    "TYPING_STOPPED",
    "SCREEN_JOIN",
    "SCREEN_START",
    "SCREEN_STOP",
    "SCREEN_STATE",
    "SCREEN_REVOKED"
  ],
  "permissions": [
    "server.view",
    "server.edit",
    "server.shutdown",
    "server.view_logs",
    "channel.create",
    "channel.edit",
    "channel.delete",
    "channel.join",
    "channel.join_full",
    "channel.join_password_bypass",
    "channel.move_self",
    "channel.move_others",
    "voice.speak",
    "voice.mute_others",
    "voice.priority_speaker",
    "user.kick",
    "user.ban",
    "user.change_others_nickname",
    "role.view",
    "role.create",
    "role.edit",
    "role.delete",
    "role.assign",
    "permissions.view",
    "permissions.edit",
    "future.screen_share",
    "future.youtube_control",
    "future.browser_start",
    "future.browser_control",
    "future.files_view",
    "future.files_upload",
    "future.files_delete",
    "chat.channel.view",
    "chat.channel.send",
    "chat.channel.history",
    "chat.channel.edit_own",
    "chat.channel.delete_own",
    "chat.channel.delete_others",
    "chat.private.send",
    "chat.moderation.view_deleted",
    "screen.share",
    "screen.watch",
    "screen.stop_others"
  ]
}
